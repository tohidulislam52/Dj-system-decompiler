		<Item class="Script" referent="RBX0000001F">
			<Properties>
				<string name="Name">MusicServer</string>
				<bool name="Disabled">false</bool>
				<token name="RunContext">1</token>
				<ProtectedString name="Source"><![CDATA[-- SETTINGS
local VOLUME = 0.5   -- 0 to 10
local RANGE  = 60    -- studs; how far the music can be heard

local model = script.Parent
local music = model.Speaker.Music
local songsFolder = model.Songs
local songLabel = model.Screen.SurfaceGui.Container.SongName

music.Volume = VOLUME
music.RollOffMode = Enum.RollOffMode.Linear
music.RollOffMaxDistance = RANGE
music.Looped = false

local last
local function pickSong()
	local list = {}
	for _, s in songsFolder:GetChildren() do
		if s:IsA("Sound") and s.SoundId ~= "" then
			table.insert(list, s)
		end
	end
	if #list == 0 then return nil end
	if #list == 1 then return list[1] end
	local s
	repeat s = list[math.random(#list)] until s ~= last
	return s
end

while true do
	local song = pickSong()
	if not song then
		songLabel.Text = "No Song"
		task.wait(3)
		continue
	end
	last = song

	music:Stop()
	music.SoundId = song.SoundId
	songLabel.Text = song.Name

	local t = 0
	while not music.IsLoaded and t < 10 do
		t += task.wait(0.2)
	end

	if music.IsLoaded then
		music.TimePosition = 0
		music:Play()
		music.Ended:Wait()
	else
		task.wait(1) -- failed to load, skip
	end
end
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX00000020">
			<Properties>
				<string name="Name">MusicDisplay</string>
				<bool name="Disabled">false</bool>
				<token name="RunContext">2</token>
				<ProtectedString name="Source"><![CDATA[local model = script.Parent
local music = model:WaitForChild("Speaker"):WaitForChild("Music")
local c = model:WaitForChild("Screen"):WaitForChild("SurfaceGui"):WaitForChild("Container")

local function fmt(t)
	t = math.floor(t)
	return string.format("%02d:%02d", t // 60, t % 60)
end

while true do
	local len = music.TimeLength
	local pos = music.TimePosition
	if music.IsPlaying and len > 0 then
		c.TimeNow.Text = fmt(pos)
		c.TimeEnd.Text = fmt(len)
		c.BarBG.BarFill.Size = UDim2.fromScale(math.clamp(pos / len, 0, 1), 1)
	end
	task.wait(0.25)
end
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
